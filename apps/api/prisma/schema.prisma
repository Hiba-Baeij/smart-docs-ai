// SmartDocs AI data model. See docs/architecture/decisions/ADR-003-data-model.md
// and docs/tracks/nestjs/02-persistence-and-migrations.md.
//
// The generated `search_vector` tsvector column and its GIN index on "DocumentChunk" are created
// by a raw SQL migration (Phase 5, ADR-004) because Prisma cannot describe a generated column.
// The model declares them as Unsupported so migrate dev sees no drift. Nothing writes the column.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Bare relative imports: Jest cannot resolve "./x.js" to the generated "x.ts".
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  user
  assistant
}

model User {
  id            String         @id @default(uuid(7))
  name          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  documents     Document[]
  conversations Conversation[]
}

model Document {
  id            String          @id @default(uuid(7))
  originalName  String
  // "pdf" | "docx" | "xlsx": a string plus a check in code, not an enum (see the persistence guide).
  fileType      String
  extractedText String          @db.Text
  status        DocumentStatus  @default(PROCESSING)
  // Meaningful only when status = FAILED; a value of the ErrorCode union, never free text.
  errorCode     String?
  uploadedBy    String
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@index([uploadedBy, createdAt])
  @@index([uploadedBy, status])
}

model DocumentChunk {
  id           String                   @id @default(uuid(7))
  documentId   String
  chunkIndex   Int
  content      String                   @db.Text
  pageNumber   Int?
  sheetName    String?
  // Generated by PostgreSQL from "content" (migration search_vector, ADR-004); the application
  // never writes it. Declared only so Prisma does not see it as drift and propose dropping it.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")
  // Unit-length embedding as real[768] (migration chunk_embedding, ADR-018). Unsupported keeps
  // 768 numbers out of every Prisma read; it is written and read only with raw SQL.
  embedding    Unsupported("real[]")?
  document     Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([searchVector], type: Gin, map: "document_chunk_search_idx")
}

model Conversation {
  id        String    @id @default(uuid(7))
  userId    String
  // May be empty; replaced by a truncated first question when the first message arrives.
  title     String    @default("")
  createdAt DateTime  @default(now())
  // @updatedAt only fires when the conversation row itself is updated, so the message
  // service must touch the conversation explicitly when it adds a message (task 7.6).
  updatedAt DateTime  @default(now()) @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid(7))
  conversationId String
  role           MessageRole
  content        String       @db.Text
  // Citation snapshot: { documentId, documentName, chunkIndex, pageNumber, sheetName }[].
  // Deliberately JSON and not a relation, so it survives deletion of the cited document.
  sources        Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
