# Copy to apps/api/.env and fill the empty values. Never commit apps/api/.env.

# --- Database ---
DATABASE_URL=postgresql://smartdocs:smartdocs@localhost:5433/smartdocs
# Must end in _test: tests refuse to run against anything else.
TEST_DATABASE_URL=postgresql://smartdocs:smartdocs@localhost:5433/smartdocs_test

# --- Auth ---
# 32+ random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# false locally, true in production
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:4200
# Login and register: at most this many requests per client per window (milliseconds).
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_MS=60000
UPLOAD_RATE_LIMIT=10
MESSAGE_RATE_LIMIT=20
GENERAL_RATE_LIMIT=120
RATE_WINDOW_MS=60000
MAX_JSON_BYTES=102400

# --- Upload ---
MAX_UPLOAD_BYTES=10485760
UPLOAD_TIMEOUT_MS=30000
MAX_EXTRACTED_CHARS=2000000

# --- LLM provider (mock needs no key) ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_MS=20000

# --- Chunking (words; maximum must be >= target + overlap + 60) ---
CHUNK_TARGET_WORDS=700
CHUNK_OVERLAP_WORDS=100
CHUNK_MAX_WORDS=1200

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOKEN_BUDGET=3000
CHAT_HISTORY_MESSAGES=6
